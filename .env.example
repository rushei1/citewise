# Copy to .env and adjust. All values shown are the defaults.

# Max papers fetched from arXiv per review (1-30)
ARXIV_MAX_RESULTS=10
# Seconds to wait for arXiv before giving up with a 502
ARXIV_TIMEOUT_SECONDS=30
# Comma list of paper sources used when the request gives none: arxiv, semantic_scholar
DEFAULT_SOURCES=arxiv
# Optional Semantic Scholar API key (higher rate limits). Works without one, but is
# heavily rate limited. Never commit a real key.
S2_API_KEY=
# Default number of clusters (1-8); clamped to the number of papers found
DEFAULT_NUM_CLUSTERS=3
# Hugging Face summarization model
SUMMARIZER_MODEL=facebook/bart-large-cnn
# Which summarizer /review uses by default: hf (BART, no key needed) or llm
SUMMARIZER_BACKEND=hf
# LLM backend. LLM_MODEL has no default; leave it unset and the llm backend is unavailable.
# LLM_PROVIDER=openai talks to any OpenAI-compatible server (OpenAI, Ollama, vLLM, ...).
LLM_PROVIDER=openai
# Optional for OpenAI itself; required for Ollama etc., e.g. http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=60
# SQLite file caching LLM outputs by hash(model, prompt version, abstract)
LLM_CACHE_PATH=data/llm_cache.db
# Sentence-transformers embedding model used for clustering
EMBEDDING_MODEL=all-MiniLM-L6-v2
# SQLite file for review history and cache
DB_PATH=data/reviews.db
# Backend URL used by the Streamlit frontend (the frontend reads this env var directly)
API_URL=http://127.0.0.1:8000
